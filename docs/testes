#include <WiFi.h>
#include <PubSubClient.h>

const char* WIFI_SSID = "projetoIntegrador";
const char* WIFI_PASSWORD = "integrador";

const char* MQTT_SERVER = "192.168.0.220";
const int MQTT_PORT = 1883;

const char* MQTT_TOPIC = "Speed-Halley/teste";

WiFiClient espClient;
PubSubClient mqttClient(espClient);

void conectarWiFi() {
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.println("Conectando ao Wi-Fi...");
  }

  Serial.println("Wi-Fi conectado!");
  Serial.println(WiFi.localIP());
}

void conectarMQTT() {
  while (!mqttClient.connected()) {
    String clientID = "ESP32-C3-";
    clientID += String(random(0xffff), HEX);

    Serial.println("Conectando ao MQTT...");

    if (mqttClient.connect(clientID.c_str())) {
      Serial.println("MQTT conectado!");
    } else {
      Serial.print("Falha na conexão MQTT: ");
      Serial.println(mqttClient.state());
      delay(2000);
    }
  }
}

void setup() {
  Serial.begin(115200);

  randomSeed(micros());

  conectarWiFi();

  mqttClient.setServer(MQTT_SERVER, MQTT_PORT);
}

void loop() {
  if (WiFi.status() != WL_CONNECTED) {
    conectarWiFi();
  }

  if (!mqttClient.connected()) {
    conectarMQTT();
  }

  mqttClient.loop();

  int numero = random(0, 101);

  char mensagem[12];
  snprintf(mensagem, sizeof(mensagem), "%d", numero);

  mqttClient.publish(MQTT_TOPIC, mensagem);

  Serial.print("Numero enviado: ");
  Serial.println(numero);

  delay(2000);
}


